{
  "name": "question-bank",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "lint:deps": "node .dependency-cruiser-runner.cjs --config .dependency-cruiser.cjs src tests",
    "test:fast": "vitest run --exclude \"tests/e2e/**\" --exclude \"tests/invariants/**\"",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "build": "electron-vite build",
    "capture": "node scripts/capture.cjs",
    "app": "electron-vite preview",
    "dev": "electron-vite dev",
    "seed": "node scripts/dev-seed.cjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.{cjs,mjs,ts}\" \"*.{ts,cjs,json}\" \"src/app/renderer/index.html\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.{cjs,mjs,ts}\" \"*.{ts,cjs,json}\" \"src/app/renderer/index.html\""
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.15.0",
    "electron-updater": "^6.8.10",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.66.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dependency-cruiser": "^16.10.4",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "description": "출판사 모의고사 문제은행",
  "main": "out/main/index.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
